# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID_NELSON=your_nelson_chat_id
TELEGRAM_CHAT_ID_NICK=your_nick_chat_id
TELEGRAM_GROUP_CHAT_ID=your_group_chat_id
# Optional: comma-separated list of additional authorized user IDs
TELEGRAM_AUTHORIZED_USERS=

# Zoho CRM
ZOHO_CLIENT_ID=your_zoho_client_id
ZOHO_CLIENT_SECRET=your_zoho_client_secret
ZOHO_REFRESH_TOKEN=your_zoho_refresh_token
ZOHO_DATACENTER=eu

# OpenAI (required for conversational AI and voice transcription)
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o

# PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/signature_crm

# Email
ZOHO_EMAIL_FROM=nick@signature-cleans.co.uk
ZOHO_EMAIL_FROM_NELSON=nelson@signature-cleans.co.uk

# App Config
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Approval Settings
APPROVAL_REQUIRED_DEAL_VALUE=5000
PROTECTED_ACCOUNTS=Porsche Centre Exeter,Bouygues UK,Certas Energy,Vistry
